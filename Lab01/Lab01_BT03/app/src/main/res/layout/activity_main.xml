<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:paddingStart="@dimen/padding_horizontal"
    android:paddingEnd="@dimen/padding_horizontal">

    <!-- SIGN IN -->
    <TextView
        android:id="@+id/tv_sign_in"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_title_top"
        android:text="@string/sign_in"
        android:textAllCaps="true"
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- USERNAME LABEL -->
    <TextView
        android:id="@+id/tv_user_name"
        android:layout_width="@dimen/label_width"
        android:layout_height="@dimen/label_height"
        android:layout_marginTop="@dimen/margin_username_top"
        android:gravity="center_vertical"
        android:text="@string/username"
        android:textSize="@dimen/text_label"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tv_sign_in"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- USERNAME INPUT -->
    <EditText
        android:id="@+id/et_username"
        android:layout_width="0dp"
        android:layout_height="@dimen/edittext_height"
        android:hint="nguyenquangtheanh@gmail.com"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:textSize="@dimen/text_input"
        app:layout_constraintTop_toTopOf="@id/tv_user_name"
        app:layout_constraintBottom_toBottomOf="@id/tv_user_name"
        app:layout_constraintStart_toEndOf="@id/tv_user_name"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- PASSWORD LABEL -->
    <TextView
        android:id="@+id/tv_password"
        android:layout_width="@dimen/label_width"
        android:layout_height="@dimen/label_height"
        android:gravity="center_vertical"
        android:text="@string/password"
        android:textSize="@dimen/text_label"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tv_user_name"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- PASSWORD INPUT -->
    <EditText
        android:id="@+id/et_password"
        android:layout_width="0dp"
        android:layout_height="@dimen/edittext_height"
        android:hint="***********"
        android:gravity="center_vertical"
        android:inputType="textPassword"
        android:singleLine="true"
        android:textSize="@dimen/text_input"
        app:layout_constraintTop_toTopOf="@id/tv_password"
        app:layout_constraintBottom_toBottomOf="@id/tv_password"
        app:layout_constraintStart_toEndOf="@id/tv_password"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- SIGN IN BUTTON -->
    <Button
        android:id="@+id/btn_sign_in"
        android:layout_width="@dimen/sign_in_button_width"
        android:layout_height="@dimen/sign_in_button_height"
        android:layout_marginTop="@dimen/margin_sign_in_top"
        android:backgroundTint="#D6D6D6"
        android:padding="0dp"
        android:text="@string/sign_in"
        android:textSize="@dimen/text_sign_in_button"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/et_password"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- SIGN IN VIA FACEBOOK -->
    <Button
        android:id="@+id/btn_facebook"
        android:layout_width="@dimen/bottom_button_width"
        android:layout_height="@dimen/bottom_button_height"
        android:layout_marginBottom="@dimen/margin_bottom_button"
        android:backgroundTint="#D6D6D6"
        android:padding="0dp"
        android:text="@string/facebook"
        android:textSize="@dimen/text_bottom_button"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/btn_sign_up"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- SIGN UP -->
    <Button
        android:id="@+id/btn_sign_up"
        android:layout_width="@dimen/bottom_button_width"
        android:layout_height="@dimen/bottom_button_height"
        android:layout_marginBottom="@dimen/margin_bottom_button"
        android:backgroundTint="#D6D6D6"
        android:padding="0dp"
        android:text="@string/signup"
        android:textSize="@dimen/text_bottom_button"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>